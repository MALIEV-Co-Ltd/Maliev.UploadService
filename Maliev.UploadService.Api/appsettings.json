{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.AspNetCore.Watch.BrowserRefresh": "None",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore.Watch": "Warning",
      "System": "Warning"
    }
  },
  "Service": {
    "Name": "UploadService",
    "Version": "1.1.0",
    "Region": "us-east1"
  },
  "AllowedHosts": "*",
  "GoogleCloudStorage": {
    "BucketName": "",
    "ProjectId": ""
  },
  "FileValidation": {
    "ClamAV": {
      "Server": "localhost",
      "Port": 3310
    },
    "MaxFileSizeMB": 100,
    "AllowedContentTypes": []
  },
  "Authorization": {
    "PolicyCacheDurationMinutes": 5
  },
  "SignedUrls": {
    "DefaultExpirationMinutes": 60,
    "MaxExpirationMinutes": 1440
  },
  "Services": {
    "IAMService": {
      "BaseUrl": "http://maliev-iamservice-api"
    }
  }
}
