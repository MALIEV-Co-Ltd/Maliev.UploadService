{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Maliev": "Information"
    }
  },
  "Service": {
    "Name": "UploadService",
    "Version": "1.1.0",
    "Region": "us-east1"
  },
  "AllowedHosts": "*",
  "GoogleCloudStorage": {
    "BucketName": "",
    "ProjectId": ""
  },
  "FileValidation": {
    "ClamAV": {
      "Server": "localhost",
      "Port": 3310
    },
    "MaxFileSizeMB": 100,
    "AllowedContentTypes": []
  },
  "Authorization": {
    "PolicyCacheDurationMinutes": 5
  },
  "IAM": {
    "BaseUrl": "http://iam-service",
    "CacheTtlMinutes": 5
  },
  "SignedUrls": {
    "DefaultExpirationMinutes": 60,
    "MaxExpirationMinutes": 1440
  }
}